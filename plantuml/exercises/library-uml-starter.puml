@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' ---------------------------------------------------------------------------
' Design decisions (one defensible answer):
'
'  * Book / DVD are separate subclasses of Item because they carry genuinely
'    different data (author/ISBN vs. director), not just a different number.
'    The loan period is *data* (a field), so it lives on Book/DVD rather than
'    forcing a class per loan length.
'  * "Borrowable" is an interface realized only by the items that can leave
'    the building. ReferenceBook extends Item but does NOT realize Borrowable,
'    so it simply cannot be borrowed — no runtime flag needed.
'  * Member and Librarian share name/id, so they get a Person supertype.
'  * A Hold is its own class because it links a Member to an Item and carries
'    state (when placed, whether ready). Both ends are associations.
' ---------------------------------------------------------------------------

interface Borrowable {
  + getLoanPeriodDays() : int
}

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

class Book {
  - author : String
  - isbn : String
  - loanPeriodDays : int
  + getLoanPeriodDays() : int
}

class DVD {
  - director : String
  - loanPeriodDays : int
  + getLoanPeriodDays() : int
}

class ReferenceBook {
  - edition : String
}

abstract class Person {
  - name : String
  - id : String
  + getName() : String
}

class Member {
  - membershipNumber : String
}

class Librarian {
  - staffNumber : String
}

class Hold {
  - placedOn : Date
  - isReady : boolean
  + isReady() : boolean
}

' --- generalization / realization -----------------------------------------
Item     <|-- Book
Item     <|-- DVD
Item     <|-- ReferenceBook
Borrowable <|.. Book
Borrowable <|.. DVD
Person   <|-- Member
Person   <|-- Librarian

' --- associations ----------------------------------------------------------
Member "1" -- "*" Hold : places >
Hold   "*" -- "1" Item : for >
Member "1" -- "*" Borrowable : borrows >
Librarian "1" -- "*" Item : manages >

@enduml