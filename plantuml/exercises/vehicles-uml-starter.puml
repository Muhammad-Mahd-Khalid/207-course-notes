@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' ---------------------------------------------------------------------------
' Chapter 3, Question 2 — Vehicle / Car / ElectricCar / Chargeable
'
'  * Vehicle is the abstract root: a few fields plus abstract methods that
'    subclasses must supply.
'  * Car is a concrete Vehicle subclass adding car-specific state.
'  * ElectricCar is a Car (a car that happens to be electric) AND it can be
'    charged, so it *realizes* the Chargeable interface.
'  * Chargeable is standalone — nothing inherits from it, it's just a contract.
' ---------------------------------------------------------------------------

interface Chargeable {
  + charge() : void
}

abstract class Vehicle {
  # make : String
  # model : String
  # year : int
  + getMake() : String
  + getModel() : String
  + getYear() : int
  + {abstract} describe() : String
}

class Car {
  - numDoors : int
  + getNumDoors() : int
  + describe() : String
}

class ElectricCar {
  - batteryCapacityKWh : double
  - chargeLevel : double
  + charge() : void
  + getRange() : double
}

' --- generalization / realization -----------------------------------------
Vehicle <|-- Car
Car     <|-- ElectricCar
Chargeable <|.. ElectricCar

@enduml